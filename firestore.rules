rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'ncatlandarch@gmail.com',
          'wcharrison@ncat.edu',
          'chris@thinkdesignplanning.com'
        ];
    }

    // Granted! University OSP NOI Submissions
    match /submissions/{docId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.piEmail == request.auth.token.email);
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.piEmail == request.auth.token.email);
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.piEmail == request.auth.token.email);
      allow delete: if isAdmin();
    }

    // Granted! User Profiles
    match /users/{uid} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // Consolidated SBIR/STTR & Grant Intelligence collections (from 2-SBIR SRTT Grants)
    match /scraped_grants/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }
    match /grant_tracker/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }
    match /user_settings/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }
    match /draft_grants/{docId} {
      allow read, write: if isSignedIn();
    }
    match /grant_sections/{docId} {
      allow read, write: if isSignedIn();
    }

    // Fail-closed default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
